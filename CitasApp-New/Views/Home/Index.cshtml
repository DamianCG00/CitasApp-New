@{
    ViewData["Title"] = "Home";
}
<div class="text-center">
    <div class="bienvenida-box">
        <h1 class="display-4">Sistema de Citas Médicas</h1>
        <p class="home-descripcion">
            Bienvenido al Sistema de Citas Médicas. Administra pacientes, médicos y citas de manera sencilla.
        </p>
        <div class="menu-principal">
            <a asp-controller="Cita" asp-action="Index" class="btn-menu">Citas</a>
            <a asp-controller="Medico" asp-action="Index" class="btn-menu">Médicos</a>
            <a asp-controller="Paciente" asp-action="Index" class="btn-menu">Pacientes</a>
        </div>
    </div>
</div>
