@model List<CitasApp.Models.Medico>
@{ ViewData["Title"] = "Médicos"; }
<h1>Médicos disponibles</h1>
<p><a asp-action="Create">Agregar médico</a></p>
<table>
    <tr><th>Nombre</th><th>Especialidad</th><th>Licencia</th><th></th></tr>
    @foreach (var m in Model) {
        <tr>
            <td>@m.Nombre @m.Apellido</td>
            <td>@m.Especialidad</td>
            <td>@m.NumeroLicencia</td>
            <td><a asp-action="Detalle" asp-route-id="@m.Id">Ver detalle</a></td>
        </tr>
    }
</table>
