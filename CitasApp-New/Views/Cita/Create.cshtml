@model CitasApp.Models.Cita
@{ ViewData["Title"] = "Agregar Cita"; }
<h1>Agregar Cita</h1>
<form method="post">
    <label>ID Paciente</label><br />
    <input asp-for="PacienteId" type="number" /><br />
    <label>ID Médico</label><br />
    <input asp-for="MedicoId" type="number" /><br />
    <label>Fecha (YYYY-MM-DD)</label><br />
    <input asp-for="Fecha" /><br />
    <label>Hora (HH:mm:ss)</label><br />
    <input asp-for="Hora" /><br />
    <label>Motivo</label><br />
    <input asp-for="Motivo" /><br />
    <label>Estado</label><br />
    <input asp-for="Estado" /><br /><br />
    <input type="submit" value="Guardar" />
</form>
<a asp-action="Index">Cancelar</a>
